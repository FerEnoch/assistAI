{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@assistai/shared": ["../../packages/shared"],
      "@assistai/shared/*": ["../../packages/shared/*"],
      "@assistai/entities": ["../../packages/entities"],
      "@assistai/entities/*": ["../../packages/entities/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/entities" }]
}
