{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@assistai/shared": ["../shared"],
      "@assistai/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist"],
  "references": [{ "path": "../shared" }]
}
