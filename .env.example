# ────────────────────────────────────────────
# AssistAI — Local Development Environment
# Copy this file to .env and fill in the values
# ────────────────────────────────────────────
NODE_ENV=development

# Dev auth bypass (skip magic-link email in development)
DEV_AUTH_BYPASS=true

# Database
DATABASE_URL=postgresql://assistai:assistai_dev@localhost:5432/assistai

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT_API=3000

# Worker
PORT_WORKER=3001

# Auth
SESSION_SECRET=3f90510dfb2995208c8ea0183d2283dc17ede045dff7d02476b746882b470aaa
CSRF_SECRET=dev-csrf-secret-at-least-32-characters-long-enough
JWT_SECRET=dev-jwt-secret-at-least-32-characters-long-enough-ok
MAGIC_LINK_URL=http://localhost:5173/auth/verify

# Credential encryption (64 hex chars = 32 bytes)
CREDENTIAL_ENCRYPTION_KEY=b90e69894137471b490f5972e0ee0fb14612fc3ca8062446eae0bff092eed21a

# Google OAuth (placeholders for local dev)
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/sources/drive/callback

# External services (placeholders)
OPENROUTER_API_KEY=placeholder-openrouter-key
OPENAI_API_KEY=placeholder-openai-key
RESEND_API_KEY=placeholder-resend-api-key

EMAIL_FROM="AssistAI <assist-ai@resend.dev>"

# Frontend
FRONTEND_URL_LOCAL=http://localhost:5173
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=AssistAI
VITE_DEV_MODE=true

# Observability (optional)
# SENTRY_DSN=https://your-sentry-dsn
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
