# ─── LOCKFILE ESTRICTO ────────────────────────────────────────────

# En CI/CD: SIEMPRE instalar desde el lockfile sin modificarlo.
# Garantiza reproducibilidad — si el lockfile no satisface package.json, falla.
# Equivalente a --frozen-lockfile en la línea de comandos.
prefer-frozen-lockfile=true

# ─── PEER DEPENDENCIES ────────────────────────────────────────────

# TODO: Activar strict-peer-dependencies=true una vez resueltas las inconsistencias preexistentes:
#   - openai@6.33.0 requiere zod@^3.25||^4.0, instalado: 3.23.0 (apps/api, apps/worker)
#   - @nestjs/mapped-types@2.0.6 requiere @nestjs/common@^8-10, instalado: 11.1.17
#   - @react-email/render@0.0.16 requiere react@^18, instalado: 19.x (apps/api via resend)
#   - @vitejs/plugin-react@4.3.0 requiere vite@^4-5, instalado: 6.0.9 (apps/web)
# Hasta entonces, desactivado para no bloquear el desarrollo.
strict-peer-dependencies=false

# Resuelve automáticamente peer dependencies faltantes.
auto-install-peers=true

# ─── NODE LINKER ──────────────────────────────────────────────────

# Modo hoisted: node_modules plano (como npm/yarn classic).
# Requerido para compatibilidad con NestJS, Vite y algunas herramientas de build.
# Alternativa: 'isolated' (más estricto, pero puede romper algunas tools).
shamefully-hoist=true
